DATABASE_URL="postgres://user:password@localhost:5432/cms"

# Also protects saved email and revalidation credentials. Keep stable and back up separately from the database.
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

S3_BUCKET="cms-uploads"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
UPLOAD_MAX_BYTES="10485760"

# Mount a persistent, private directory here in production (outside public/).
ASSET_CACHE_DIR=".cache/assets"
ASSET_CACHE_MAX_BYTES="1073741824"
ASSET_CACHE_MAX_OBJECT_BYTES="134217728"
ASSET_ORIGIN_CONCURRENCY="4"
